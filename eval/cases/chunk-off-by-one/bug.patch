+"""Split a sequence into consecutive chunks."""
+
+
+def chunk_items(items, size):
+    """Return items split into consecutive chunks.
+
+    Every element appears exactly once, in its original order,
+    and no chunk is empty. The final chunk is shorter than
+    size when the input does not divide evenly.
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1")
+    chunks = []
+    for start in range(0, len(items), size):
+        chunks.append(list(items[start : start + size - 1]))
+    return chunks
